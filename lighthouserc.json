{
  "ci": {
    "collect": {
      "url": ["http://127.0.0.1:43177/"],
      "startServerCommand": "PORT=43177 node tool/runtime/serve_web.mjs",
      "startServerReadyPattern": "Flutter web test server listening on",
      "startServerReadyTimeout": 15000,
      "numberOfRuns": 3,
      "settings": {
        "skipAudits": ["deprecations"]
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "categories:performance": ["warn", { "minScore": 0.95 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/mobile"
    }
  }
}
