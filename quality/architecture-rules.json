{
  "version": 1,
  "doc": "docs/ARCHITECTURE-RULES.md",
  "baseline": "quality/architecture-baseline.json",
  "sources": [
    {
      "dir": "lib",
      "lang": "dart",
      "dart_package": "flutter_web_portfolio"
    }
  ],
  "exclude": [
    "**/*.g.dart",
    "**/*.freezed.dart",
    "**/*.gr.dart",
    "**/*.mocks.dart",
    "**/generated/**",
    "**/app_localizations*.dart",
    "**/gen_l10n/**"
  ],
  "layers": {
    "features": [
      "lib/app/features/**"
    ],
    "presentation": [
      "lib/app/modules/**",
      "lib/app/widgets/**"
    ],
    "application": [
      "lib/app/features/*/application/**",
      "lib/app/controllers/**",
      "lib/app/narrative/application/**"
    ],
    "data": [
      "lib/app/data/**"
    ],
    "domain": [
      "lib/app/domain/**",
      "lib/app/features/*/domain/**",
      "lib/app/narrative/domain/**"
    ],
    "core": [
      "lib/app/core/**"
    ]
  },
  "rules": [
    {
      "id": "F-ISOLATION",
      "kind": "isolate",
      "pattern": "lib/app/features/{feature}/**",
      "to_except": [],
      "why": "features do not depend on other features"
    },
    {
      "id": "F-PRESENTATION-NO-IO",
      "kind": "external-deny",
      "from": [
        "@presentation"
      ],
      "packages": [
        "dart:io",
        "package:http/",
        "package:dio/",
        "package:drift/",
        "package:sqflite",
        "package:hive",
        "package:shared_preferences/",
        "package:purchases_flutter/",
        "package:supabase",
        "package:firebase",
        "package:cloud_firestore/"
      ],
      "why": "presentation does not import I/O packages"
    },
    {
      "id": "F-PRESENTATION-NO-DATA",
      "kind": "forbid",
      "from": [
        "@presentation"
      ],
      "to": [
        "@data"
      ],
      "why": "presentation does not import data adapters"
    },
    {
      "id": "P-DATA-DOWN",
      "kind": "forbid",
      "from": [
        "lib/app/data/**"
      ],
      "to": [
        "@presentation",
        "lib/app/controllers/**",
        "lib/app/features/**",
        "lib/app/narrative/**"
      ],
      "why": "data does not depend on outer layers"
    },
    {
      "id": "P-WIDGETS-NO-MODULES",
      "kind": "forbid",
      "from": [
        "lib/app/widgets/**"
      ],
      "to": [
        "lib/app/modules/**"
      ],
      "why": "widgets do not import page modules"
    },
    {
      "id": "F-DOMAIN-PURE",
      "kind": "external-allow-only",
      "from": [
        "@domain"
      ],
      "packages": [
        "dart:core",
        "dart:async",
        "dart:collection",
        "dart:convert",
        "dart:math",
        "dart:typed_data",
        "package:meta/",
        "package:freezed_annotation/"
      ],
      "why": "domain uses framework-independent imports"
    },
    {
      "id": "F-DOMAIN-INWARD",
      "kind": "forbid",
      "from": [
        "@domain"
      ],
      "to": [
        "lib/app/data/**",
        "@presentation",
        "lib/app/controllers/**",
        "lib/app/features/*/application/**",
        "lib/app/narrative/application/**",
        "lib/app/narrative/rendering/**"
      ],
      "why": "domain does not depend on outer layers"
    },
    {
      "id": "F-FORBIDDEN-SDK",
      "kind": "external-deny",
      "from": [
        "lib/**"
      ],
      "packages": [
        "package:firebase",
        "package:cloud_firestore/",
        "package:sentry",
        "package:supabase",
        "package:clerk"
      ],
      "why": "application code does not import prohibited SDKs"
    }
  ],
  "calibration": [
    {
      "file": "lib/app/features/alpha/calibration_probe.dart",
      "source": "import 'package:flutter_web_portfolio/app/features/beta/calibration_probe.dart';\n",
      "expect": [
        "F-ISOLATION"
      ],
      "covers": [
        "F-ISOLATION"
      ]
    },
    {
      "file": "lib/app/widgets/calibration_probe.dart",
      "source": "import 'package:http/probe.dart';\n",
      "expect": [
        "F-PRESENTATION-NO-IO"
      ],
      "covers": [
        "F-PRESENTATION-NO-IO"
      ]
    },
    {
      "file": "lib/app/modules/calibration_probe.dart",
      "source": "import 'dart:io';\n",
      "expect": [
        "F-PRESENTATION-NO-IO"
      ],
      "covers": [
        "F-PRESENTATION-NO-IO"
      ]
    },
    {
      "file": "lib/app/modules/calibration_probe.dart",
      "source": "import 'package:flutter_web_portfolio/app/data/calibration_probe.dart';\n",
      "expect": [
        "F-PRESENTATION-NO-DATA"
      ],
      "covers": [
        "F-PRESENTATION-NO-DATA"
      ]
    },
    {
      "file": "lib/app/data/calibration_probe.dart",
      "source": "import 'package:flutter_web_portfolio/app/modules/calibration_probe.dart';\n",
      "expect": [
        "P-DATA-DOWN"
      ],
      "covers": [
        "P-DATA-DOWN"
      ]
    },
    {
      "file": "lib/app/widgets/calibration_probe.dart",
      "source": "import 'package:flutter_web_portfolio/app/modules/calibration_probe.dart';\n",
      "expect": [
        "P-WIDGETS-NO-MODULES"
      ],
      "covers": [
        "P-WIDGETS-NO-MODULES"
      ]
    },
    {
      "file": "lib/app/domain/models/calibration_probe.dart",
      "source": "import 'package:flutter/material.dart';\n",
      "expect": [
        "F-DOMAIN-PURE"
      ],
      "covers": [
        "F-DOMAIN-PURE"
      ]
    },
    {
      "file": "lib/app/domain/models/calibration_probe.dart",
      "source": "import 'dart:ui';\n",
      "expect": [
        "F-DOMAIN-PURE"
      ],
      "covers": [
        "F-DOMAIN-PURE"
      ]
    },
    {
      "file": "lib/app/domain/models/calibration_probe.dart",
      "source": "import 'package:flutter_web_portfolio/app/data/calibration_probe.dart';\n",
      "expect": [
        "F-DOMAIN-INWARD"
      ],
      "covers": [
        "F-DOMAIN-INWARD"
      ]
    },
    {
      "file": "lib/calibration_probe.dart",
      "source": "import 'package:firebase/probe.dart';\n",
      "expect": [
        "F-FORBIDDEN-SDK"
      ],
      "covers": [
        "F-FORBIDDEN-SDK"
      ]
    },
    {
      "file": "lib/app/widgets/calibration_probe.dart",
      "source": "import 'package:flutter_web_portfolio/app/features/language/application/language_cubit.dart';\n",
      "expect": [],
      "covers": [
        "F-PRESENTATION-NO-IO",
        "F-PRESENTATION-NO-DATA"
      ]
    },
    {
      "file": "lib/app/modules/calibration_probe.dart",
      "source": "import 'package:flutter_web_portfolio/app/domain/models/portfolio_document.dart';\n",
      "expect": [],
      "covers": [
        "F-PRESENTATION-NO-IO",
        "F-PRESENTATION-NO-DATA"
      ]
    },
    {
      "file": "lib/app/modules/calibration_probe.dart",
      "source": "import 'package:flutter_web_portfolio/app/core/constants/app_colors.dart';\n",
      "expect": [],
      "covers": [
        "F-PRESENTATION-NO-IO",
        "F-PRESENTATION-NO-DATA"
      ]
    },
    {
      "file": "lib/app/data/calibration_probe.dart",
      "source": "import 'package:flutter_web_portfolio/app/domain/providers/asset_loader.dart';\n",
      "expect": [],
      "covers": [
        "P-DATA-DOWN"
      ]
    },
    {
      "file": "lib/app/widgets/calibration_probe.dart",
      "source": "import 'package:flutter_web_portfolio/app/core/constants/app_colors.dart';\n",
      "expect": [],
      "covers": [
        "P-WIDGETS-NO-MODULES"
      ]
    },
    {
      "file": "lib/app/domain/models/calibration_probe.dart",
      "source": "import 'dart:core';\n",
      "expect": [],
      "covers": [
        "F-DOMAIN-PURE"
      ]
    },
    {
      "file": "lib/app/domain/models/calibration_probe.dart",
      "source": "import 'package:flutter_web_portfolio/app/domain/providers/asset_loader.dart';\n",
      "expect": [],
      "covers": [
        "F-DOMAIN-INWARD"
      ]
    },
    {
      "file": "lib/calibration_probe.dart",
      "source": "import 'package:flutter/material.dart';\n",
      "expect": [],
      "covers": [
        "F-FORBIDDEN-SDK"
      ]
    },
    {
      "file": "lib/app/features/alpha/calibration_probe.g.dart",
      "source": "import 'package:http/http.dart';\n",
      "expect": []
    },
    {
      "file": "lib/app/features/alpha/calibration_probe.dart",
      "source": "import 'package:flutter_web_portfolio/app/features/alpha/calibration_sibling.dart';\n",
      "expect": [],
      "covers": [
        "F-ISOLATION"
      ]
    },
    {
      "file": "lib/app/features/alpha/providers/calibration_probe.dart",
      "source": "import 'package:drift/drift.dart';\n",
      "expect": []
    }
  ]
}
