{
  "name": "flutter-web-portfolio",
  "version": "2.0.1",
  "private": true,
  "description": "A JSON-driven Flutter Web portfolio template with measured navigation, accessible editorial layouts, and a dual-runtime Wasm release.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "setup:browsers": "playwright install chromium",
    "portfolio:init": "node tool/init_portfolio.mjs",
    "portfolio:validate": "dart run tool/validate_portfolio.dart",
    "test:template": "node tool/test_portfolio_init.mjs",
    "test:starter": "node --test tool/test_starter_readme.mjs tool/test_package_links.mjs",
    "test:clone": "node tool/test_template_clone.mjs",
    "test:release-security": "node tool/test_release_security.mjs",
    "test:refresh": "node tool/test_refresh_portfolio_data.mjs",
    "test:content": "node tool/test_sync_public_content.mjs",
    "resume:build": "node tool/resume/build_resume_pdf.mjs",
    "test:resume": "node --test tool/resume/",
    "refresh:data": "node tool/refresh_portfolio_data.mjs",
    "build:release": "node tool/build_portfolio.mjs",
    "deploy": "node tool/deploy_portfolio.mjs",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test --config playwright.prod.config.ts",
    "typecheck": "tsc --noEmit",
    "test:visual": "playwright test tests/e2e/visual.spec.ts",
    "test:visual:update": "playwright test tests/e2e/visual.spec.ts --update-snapshots",
    "sync:content": "node tool/sync_public_content.mjs",
    "verify:content": "node tool/sync_public_content.mjs --check",
    "audit:sources": "node tool/audit_public_sources.mjs",
    "audit:history": "node tool/audit_repository_history.mjs",
    "render:social-card": "node tool/render_social_card.mjs",
    "verify:social-card": "node tool/render_social_card.mjs --verify",
    "render:work-artifacts": "node tool/render_work_artifacts.mjs",
    "verify:work-artifacts": "node tool/render_work_artifacts.mjs --check",
    "test:work-artifacts": "node --test tool/work_artifacts/test_work_artifacts.mjs",
    "verify:source": "node tool/verify_dart_reachability.mjs",
    "verify:hosting": "node tool/verify_hosting_configs.mjs",
    "verify:community": "node tool/verify_community_files.mjs",
    "verify:toolchain": "node tool/verify_toolchain.mjs --current",
    "prepare:source": "node tool/render_social_card.mjs && node tool/write_source_manifest.mjs",
    "prepare:bundle": "node tool/prepare_web_release.mjs",
    "verify:bundle": "node tool/verify_web_build.mjs",
    "measure:runtime": "node tool/measure_web_runtime.mjs",
    "verify:runtime": "node tool/measure_web_runtime.mjs --enforce",
    "fonts:subset": "node tool/subset_fonts.mjs",
    "verify:fonts": "node tool/subset_fonts.mjs --check",
    "test:fonts": "node tool/test_subset_fonts.mjs",
    "test:visual:docker": "bash tool/run_visual_in_docker.sh",
    "generate:strings": "node tool/generate_app_strings.mjs",
    "verify:strings": "node tool/generate_app_strings.mjs --check",
    "test:strings": "node tool/test_generate_app_strings.mjs"
  },
  "keywords": [
    "flutter",
    "flutter-web",
    "webassembly",
    "skwasm",
    "playwright",
    "portfolio",
    "portfolio-template",
    "static-site",
    "firebase-hosting",
    "cloudflare-pages"
  ],
  "license": "MIT",
  "type": "commonjs",
  "homepage": "https://developeryusuf.com",
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "24.13.3",
    "subset-font": "2.9.0",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Yusufihsangorgel/Flutter-Web-Portfolio.git"
  }
}
