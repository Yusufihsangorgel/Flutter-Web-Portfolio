{
  "name": "flutter-web-portfolio",
  "version": "2.0.1",
  "private": true,
  "description": "A JSON-driven Flutter Web portfolio template with measured navigation, accessible editorial layouts, and a dual-runtime Wasm release.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "setup:browsers": "playwright install chromium",
    "portfolio:init": "node tool/template/init_portfolio.mjs",
    "portfolio:validate": "dart run tool/content/validate_portfolio.dart",
    "test:template": "node tool/template/test_portfolio_init.mjs",
    "test:starter": "node --test tool/template/test_starter_readme.mjs tool/template/test_package_links.mjs",
    "test:clone": "node tool/template/test_template_clone.mjs",
    "test:release-security": "node tool/release/test_release_security.mjs",
    "test:refresh": "node tool/refresh/test_refresh_portfolio_data.mjs",
    "test:content": "node tool/content/test_sync_public_content.mjs",
    "refresh:data": "node tool/refresh/refresh_portfolio_data.mjs",
    "build:release": "node tool/release/build_portfolio.mjs",
    "deploy": "node tool/release/deploy_portfolio.mjs",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test --config playwright.prod.config.ts",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.tools.json",
    "lint": "eslint 'tool/**/*.mjs'",
    "format:check": "prettier --check 'tool/**/*.mjs' eslint.config.mjs",
    "test:audit": "node tool/audit/test_audit_repository_history.mjs",
    "test:tooling": "node --test tool/quality/test_tooling_config.mjs",
    "test:visual": "playwright test tests/e2e/visual.spec.ts",
    "test:visual:update": "playwright test tests/e2e/visual.spec.ts --update-snapshots",
    "sync:content": "node tool/content/sync_public_content.mjs",
    "verify:content": "node tool/content/sync_public_content.mjs --check",
    "audit:sources": "node tool/audit/audit_public_sources.mjs",
    "audit:history": "node tool/audit/audit_repository_history.mjs",
    "render:social-card": "node tool/assets/render_social_card.mjs",
    "verify:social-card": "node tool/assets/render_social_card.mjs --verify",
    "render:work-artifacts": "node tool/work_artifacts/render_work_artifacts.mjs",
    "verify:work-artifacts": "node tool/work_artifacts/render_work_artifacts.mjs --check",
    "test:work-artifacts": "node --test tool/work_artifacts/test_work_artifacts.mjs",
    "verify:source": "node tool/quality/verify_dart_reachability.mjs",
    "verify:hosting": "node tool/release/verify_hosting_configs.mjs",
    "verify:community": "node tool/quality/verify_community_files.mjs",
    "verify:toolchain": "node tool/quality/verify_toolchain.mjs --current",
    "prepare:source": "node tool/assets/render_social_card.mjs && node tool/release/write_source_manifest.mjs",
    "prepare:bundle": "node tool/release/prepare_web_release.mjs",
    "verify:bundle": "node tool/release/verify_web_build.mjs",
    "measure:runtime": "node tool/runtime/measure_web_runtime.mjs",
    "verify:runtime": "node tool/runtime/measure_web_runtime.mjs --enforce",
    "test:release-document": "node --test tool/release/test_render_static_document.mjs tool/release/test_verify_release_document.mjs",
    "test:hosting-security": "node tool/release/test_verify_hosting_configs.mjs && node tool/public-content/test_public_content_security.mjs",
    "lighthouse": "lhci autorun",
    "lighthouse:desktop": "lhci autorun --collect.settings.preset=desktop --upload.outputDir=.lighthouseci/desktop",
    "fonts:subset": "node tool/fonts/subset_fonts.mjs",
    "verify:fonts": "node tool/fonts/subset_fonts.mjs --check",
    "test:fonts": "node tool/fonts/test_subset_fonts.mjs",
    "test:visual:docker": "bash tool/runtime/run_visual_in_docker.sh",
    "generate:strings": "node tool/content/generate_app_strings.mjs",
    "verify:strings": "node tool/content/generate_app_strings.mjs --check",
    "test:strings": "node tool/content/test_generate_app_strings.mjs"
  },
  "keywords": [
    "flutter",
    "flutter-web",
    "webassembly",
    "skwasm",
    "playwright",
    "portfolio",
    "portfolio-template",
    "static-site",
    "firebase-hosting",
    "cloudflare-pages"
  ],
  "license": "MIT",
  "type": "commonjs",
  "homepage": "https://developeryusuf.com",
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "subset-font": "2.9.0",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Yusufihsangorgel/Flutter-Web-Portfolio.git"
  }
}
